  "info": {
    "title": "r2 web",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/p/{project}/file": {
      "get": {
        "description": "A file of the working tree. This route serves the user's repository\nto a browser, so the path is checked twice: for its shape here, and\nagainst a symlink that leaves the project in `confine`.",
        "operationId": "file_api_p__project__file_get",
        "parameters": [
          {
            "in": "path",
            "name": "project",
            "required": true,
            "schema": {
              "title": "Project",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "path",
            "required": false,
            "schema": {
              "default": "",
              "title": "Path",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WireFile"
                }
              }
            },
            "description": "Successful Response"
          },
          "415": {
            "description": "Not a text file"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "File"
      }
    },
    "/api/p/{project}/files": {
      "get": {
        "operationId": "files_api_p__project__files_get",
        "parameters": [
          {
            "in": "path",
